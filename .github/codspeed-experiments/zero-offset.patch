+                        Token::new(1, 0, 1, 0, None, Some(0)),
+                        Token::new(2, 0, 2, 0, Some(0), None),
+                        Token::new(3, 0, 3, 0, None, None),
+                    ];
+                    let map = SourceMap::new(
+                        None,
+                        vec![Cow::Borrowed("name")],
+                        None,
+                        vec![Cow::Borrowed("input.js")],
+                        vec![None],
+                        tokens.into(),
+                        None,
+                    );
+                    let expected: Vec<_> = tokens
+                        .iter()
+                        .map(|token| {
+                            Token::new(
+                                token.get_dst_line() + line_offset,
+                                token.get_dst_col(),
+                                token.get_src_line(),
+                                token.get_src_col(),
+                                token.get_source_id().map(|id| id + source_offset as u32),
+                                token.get_name_id().map(|id| id + name_offset as u32),
+                            )
+                        })
+                        .collect();
+                    let mut borrowed = ConcatSourceMapBuilder::default();
+                    borrowed.add_sourcemap(&prefix, 0);
+                    borrowed.add_sourcemap(&map, line_offset);
+                    let borrowed = borrowed.into_sourcemap();
+                    let owned = ConcatSourceMapBuilder::from_owned_sourcemaps(vec![
+                        (prefix.clone(), 0),
+                        (map.clone(), line_offset),
+                    ])
+                    .into_sourcemap();
+                    assert_eq!(borrowed.tokens.as_ref(), expected);
+                    assert_eq!(owned.tokens.as_ref(), expected);
+                    assert_eq!(borrowed.to_json_string(), owned.to_json_string());
+                }
+            }
+        }
+    }
