# Assets

## nested-eval.js

```js
// nested-eval.js
(() => {
	const x = 1;
	console.log(x, eval("x"));
})();

```

## nested-no-eval.js

```js
// nested-no-eval.js
(() => {
	console.log(1, evil("x"));
})();

```

## top-level-eval.js

```js
// top-level-eval.js
const x = 1;
console.log(x, eval("x"));

```

## top-level-no-eval.js

```js
// top-level-no-eval.js
console.log(1, evil("x"));

```

## ts-namespace-eval.js

```js
// ts-namespace-eval.ts
let z;
(function(_z) {
	const x = _z.x = 1;
	console.log(x, eval("x"));
})(z || (z = {}));

```

## ts-namespace-no-eval.js

```js
// ts-namespace-no-eval.ts
let y;
(function(_y) {
	const x = _y.x = 1;
	console.log(x, evil("x"));
})(y || (y = {}));

```
