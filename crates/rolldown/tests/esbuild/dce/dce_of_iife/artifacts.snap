# Assets

## keep-these.js

```js
// keep-these.js
undef = void 0;
(() => {
	keepMe();
})();
((x = keepMe()) => {})();
var someVar;
(([y]) => {})(someVar);
(({ z }) => {})(someVar);
(/* @__PURE__ */ (() => stuff())())();
((_ = keepMe()) => {})();
var isPure = ((x, y) => 123)();
use(isPure);
var isNotPure = ((x = foo, y = bar) => 123)();
use(isNotPure);
(async () => ({ get then() {
	notPure();
} }))();
(async function() {
	return { get then() {
		notPure();
	} };
})();

```

