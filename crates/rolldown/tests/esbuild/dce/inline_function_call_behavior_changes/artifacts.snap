# Assets

## entry.js

```js
// entry.js
function id(x) {
	return x;
}
let shouldBeWrapped = [
	id(foo.bar)(),
	id(foo[bar])(),
	id(foo?.bar)(),
	id(foo?.[bar])(),
	(0, foo.bar)(),
	(0, foo[bar])(),
	(0, foo?.bar)(),
	(0, foo?.[bar])(),
	id(eval)(),
	id(eval)?.(),
	(0, eval)(),
	(0, eval)?.(),
	id(foo.bar)` + "``" + `,
	id(foo[bar])` + "``" + `,
	id(foo?.bar)` + "``" + `,
	id(foo?.[bar])` + "``" + `,
	(0, foo.bar)` + "``" + `,
	(0, foo[bar])` + "``" + `,
	(0, foo?.bar)` + "``" + `,
	(0, foo?.[bar])` + "``" + `,
	(foo, true),
	(foo.bar, true),
	(foo[bar], true),
	(foo?.bar, true),
	(foo?.[bar], true),
	(foo, true),
	(foo.bar, true),
	(foo[bar], true),
	(foo?.bar, true),
	(foo?.[bar], true),
	true
];
let shouldNotBeWrapped = [
	id(foo)(),
	foo(),
	id(foo)` + "``" + `,
	foo` + "``" + `
];
let shouldNotBeDoubleWrapped = [(foo(), bar(), true), (foo(), bar(), true)];

export { shouldBeWrapped, shouldNotBeDoubleWrapped, shouldNotBeWrapped };

```
