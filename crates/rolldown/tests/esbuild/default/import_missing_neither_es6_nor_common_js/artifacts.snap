	default: () => _default,
	x: () => x,
	y: () => y
});
var _default, x, y;
var init_foo = __esmMin((() => {
	console.log("no exports here");
	_default = void 0;
	x = void 0;
	y = void 0;
}));

export { y as a, x as i, foo_exports as n, __toCommonJS as o, init_foo as r, _default as t };

