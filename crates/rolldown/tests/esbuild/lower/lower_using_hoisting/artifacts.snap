## hoist-export-function-direct.js

```js
// hoist-export-function-direct.js
using a = b;
function foo1() {
	return [a, c];
}
function bar1() {
	return [
		a,
		c,
		bar1
	];
}
using c = d;

export { bar1, foo1 };

```

