## hoist-export-local-direct.js

```js
// hoist-export-local-direct.js
using a = b;
var ac1 = [a, c], { x: [x1] } = foo;
let a1 = a, { y: [y1] } = foo;
const c1 = c, { z: [z1] } = foo;
var { x: [x2] } = foo;
let { y: [y2] } = foo;
const { z: [z2] } = foo;
using c = d;

export { a1, ac1, c1, x1, y1, z1 };

```

## hoist-export-local-indirect.js

```js
// hoist-export-local-indirect.js
using a = b;
var { x: [x1] } = foo;
let { y: [y1] } = foo;
const { z: [z1] } = foo;
var { x: [x2] } = foo;
let { y: [y2] } = foo;
const { z: [z2] } = foo;
using c = d;

export { x1, y1, z1 };

```

