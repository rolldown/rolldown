```

## factory.js

```js
import { version } from "./index.js";

// factory.js
const getVersion = () => version;
const createIcon = (name) => {
	(globalThis.loadOrder ??= []).push(name);
	return name;
};

export { createIcon, getVersion };
```

## index.js

```js
import { IconA } from "./a.js";
import { IconB } from "./b.js";
import { createIcon, getVersion } from "./factory.js";

// index.js
const version = "1.0.0";

export { IconA, IconB, createIcon, getVersion, version };
```
