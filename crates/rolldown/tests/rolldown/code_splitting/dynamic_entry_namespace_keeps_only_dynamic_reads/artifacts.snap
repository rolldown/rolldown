## main1.js

```js
import { n as X } from "./lib.js";
//#region main1.js
const fromMain1 = X.value;
const loadX = () => import("./lib.js").then((n) => n.t).then((lib) => lib.X.value);
//#endregion
export { fromMain1, loadX };

```

