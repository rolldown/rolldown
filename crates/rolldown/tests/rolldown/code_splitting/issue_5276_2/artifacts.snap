## main.js

```js
import "./imp.js";
import assert from "node:assert";
// main.js
assert.strictEqual(2, 2);
assert.strictEqual(22, 22);
const load = async () => {
	import("./imp.js").then((n) => n.r).then((m) => {
		assert.strictEqual(m.imp22, 22);
	});
	import("./imp.js").then((n) => n.t).then((m) => {
		assert.strictEqual(m.other, "other");
	});
};
load();

```

