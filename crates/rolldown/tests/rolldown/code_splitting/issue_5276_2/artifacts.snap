### main.js

```js
const require_rolldown_runtime = require("./rolldown-runtime.js");
require("./imp.js");
let node_assert = require("node:assert");
node_assert = require_rolldown_runtime.__toESM(node_assert);
// main.js
node_assert.default.strictEqual(2, 2);
node_assert.default.strictEqual(22, 22);
const load = async () => {
	Promise.resolve().then(() => require("./imp.js")).then((n) => n.imp_exports).then((m) => {
		node_assert.default.strictEqual(m.imp22, 22);
	});
	Promise.resolve().then(() => require("./imp.js")).then((n) => n.imp_other_exports).then((m) => {
		node_assert.default.strictEqual(m.other, "other");
	});
};
load();

```

