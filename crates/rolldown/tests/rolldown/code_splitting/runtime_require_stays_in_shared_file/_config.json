{
  "config": {
    "input": [
      {
        "name": "a",
        "import": "a.js"
      },
      {
        "name": "b",
        "import": "b.js"
      }
    ],
    "platform": "node",
    "format": "esm",
    "entryFilenames": "[name]/entry.js",
    "chunkFilenames": "shared/[name].js",
    "strictExecutionOrder": true,
    "preserveEntrySignatures": "false",
    "codeSplitting": {
      "experimentalInlineCommonChunks": {
        "maxSize": 4096
      }
    }
  },
  "snapshot": false,
  "configVariants": [
    {
      "minify": true
    }
  ]
}
