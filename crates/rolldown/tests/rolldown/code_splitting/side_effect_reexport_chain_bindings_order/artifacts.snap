## Assets

### bar.js

```js
// lib/bar_impl.js
const bar = "bar";
// lib/bar.js
console.log("bar effect");
export { bar as t };

```

### entry1.js

```js
import { t as foo } from "./foo.js";
import { t as bar } from "./bar.js";
// entry1.js
console.log("entry1", bar, foo);

```

### entry2.js

```js
import { t as foo } from "./foo.js";
// entry2.js
console.log("entry2", foo);

```

### entry3.js

```js
import { t as bar } from "./bar.js";
// entry3.js
console.log("entry3", bar);

```

### foo.js

```js
// lib/foo_impl.js
