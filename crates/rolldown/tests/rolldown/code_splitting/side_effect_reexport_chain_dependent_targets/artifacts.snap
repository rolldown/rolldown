## Assets

### bar_impl.js

```js
// lib/bar_impl.js
const bar = "bar";
export { bar as t };

```

### entry1.js

```js
import { t as foo } from "./t1.js";
import "./t2.js";
import { t as bar } from "./bar_impl.js";
// entry1.js
console.log("entry1", bar, foo);

```

### entry2.js

```js
import { t as foo } from "./t1.js";
// entry2.js
console.log("entry2", foo);

```

### entry3.js

```js
