## Assets

### a.js

```js
// lib/foo_impl.js
const foo = "foo";
// lib/a.js
console.log("A");
export { foo as t };

```

### b.js

```js
import "./a.js";
// lib/bar_impl.js
const bar = "bar";
// lib/b.js
console.log("B");
export { bar as t };

```

### entry1.js

```js
import { t as bar } from "./b.js";
import { t as foo } from "./a.js";
// entry1.js
console.log("entry1", foo, bar);

```

### entry2.js

```js
import { t as bar } from "./b.js";
import { t as foo } from "./a.js";
// entry2.js
console.log("entry2", bar, foo);

```

### entry3.js

```js
import { t as foo } from "./a.js";
// entry3.js
console.log("entry3", foo);

```
