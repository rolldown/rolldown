# Assets

## a.js

```js
import { t as foo } from "./foo.js";
//#region a.js
const a = () => foo.value;
//#endregion
export { a };

```

## b.js

```js
import { t as foo } from "./foo.js";
import { t as Bar } from "./lib.js";
//#region b.js
const b = () => new Bar().value() + foo.value;
//#endregion
export { b };

```

## foo.js

```js
//#region lib/foo.js
const foo = { value: "foo" };
//#endregion
export { foo as t };

```

## lib.js

```js
import { t as foo } from "./foo.js";
//#region lib/heavy.js
function heavy() {
	return "HEAVY".repeat(3);
}
//#endregion
//#region lib/bar.js
var Bar = class {
	value() {
		return heavy() + foo.value;
	}
};
//#endregion
//#region lib/index.js
const own = { bar: Bar };
//#endregion
export { own, Bar as t };

```

## main.js

```js
//#region main.js
const loadA = () => import("./a.js");
const loadB = () => import("./b.js");
const loadOwn = () => import("./lib.js").then((lib) => lib.own);
//#endregion
export { loadA, loadB, loadOwn };

```
