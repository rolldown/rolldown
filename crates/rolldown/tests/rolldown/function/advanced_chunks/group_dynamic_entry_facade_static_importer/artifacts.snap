## group-c.js

```js
import "./group-a.js";
import "./group-b.js";
// c1.js
(globalThis.log ??= []).push("c1");
// c2.js
(globalThis.log ??= []).push("c2");

```

## main.js

```js
import "./group-c.js";
import assert from "node:assert";
// main.js
assert.deepStrictEqual(globalThis.log, [
	"a",
	"b",
	"c1",
	"c2"
]);
import("./group-a.js").then((m) => m.default());

```

