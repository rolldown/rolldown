{
  "_comment": "The non-recursive group captures `e.js` and `s.js`. The emitted `e.js` imports a separate `p.js` chunk. Running `main.js` asserts the order `p`, `s`, `e`.",
  "config": {
    "input": [
      {
        "name": "main",
        "import": "./main.js"
      },
      {
        "name": "e",
        "import": "./e.js"
      }
    ],
    "preserveEntrySignatures": "allow-extension",
    "codeSplitting": {
      "groups": [
        {
          "test": "[\\\\/](e|s)\\.js$",
          "name": "g",
          "includeDependenciesRecursively": false
        }
      ]
    }
  }
}
