# Assets

## dynamic.js

```js
import { t as value } from "./main.js";

// dynamic.js
console.log("dynamic", value);
const dynamic = value;

export { dynamic };

```

## main.js

```js
// shared.js
console.log("shared");
const value = "shared";

// main.js
console.log("main", value);
function load() {
	return import("./dynamic.js");
}

export { load, value as t };

```

