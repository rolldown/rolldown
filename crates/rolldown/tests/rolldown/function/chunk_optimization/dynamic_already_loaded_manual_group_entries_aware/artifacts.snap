# Assets

## main.js

```js
import { i as c0, n as c2, r as c1, t as c3 } from "./vendor~main.js";
// main.js
globalThis.entriesAwareMain = {
	core: [
		c0,
		c1,
		c2,
		c3
	].map((module) => module.name).join(),
	routes: [
		() => import("./r0.js"),
		() => import("./r1.js"),
		() => import("./r2.js"),
		() => import("./r3.js")
	]
};

```

## r0.js

```js
import { i as c0, r as c1 } from "./vendor~main.js";
// routes/r0.js
const value = c0.name + c1.name;
export { value };

```

