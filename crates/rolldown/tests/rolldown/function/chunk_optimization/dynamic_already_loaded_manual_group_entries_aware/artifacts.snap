## vendor~main.js

```js
// core/c0.js
const c0 = { name: "c0" };
// core/c1.js
const c1 = { name: "c1" };
// core/c2.js
const c2 = { name: "c2" };
// core/c3.js
const c3 = { name: "c3" };
export { c0 as i, c2 as n, c1 as r, c3 as t };

