# Assets

## dynamic-leaf.js

```js
import { r as leaf } from "./shared.js";
// dynamic-leaf.js
const value = leaf();
export { value };

```

## dynamic-middle.js

```js
import { n as middle } from "./shared.js";
// dynamic-middle.js
const value = middle();
export { value };

```

## main1.js

```js
import { t as shared } from "./shared.js";
// main1.js
const value = shared();
const loadMiddle = () => import("./dynamic-middle.js");
const loadLeaf = () => import("./dynamic-leaf.js");
export { loadLeaf, loadMiddle, value };

```

