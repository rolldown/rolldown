{
  "config": {
    "input": [
      { "name": "a", "import": "./a.js" },
      { "name": "b", "import": "./b.js" }
    ],
    "external": ["node:assert/strict"],
    "preserveEntrySignatures": "false",
    "experimentalInlineCommonChunks": { "maxSize": 2000 },
    "entryFilenames": "entries/[name].js",
    "chunkFilenames": "chunks/[name]-[hash].js"
  },
  "snapshot": false
}
