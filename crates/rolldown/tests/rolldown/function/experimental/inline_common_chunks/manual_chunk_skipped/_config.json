{
  "config": {
    "input": [
      { "name": "a", "import": "./a.js" },
      { "name": "b", "import": "./b.js" }
    ],
    "preserveEntrySignatures": "false",
    "experimentalInlineCommonChunks": { "maxSize": 2000 },
    "codeSplitting": {
      "groups": [
        {
          "name": "manual-shared",
          "test": "[\\\\/]shared\\.js$"
        }
      ]
    },
    "entryFilenames": "[name].js",
    "chunkFilenames": "chunks/[name]-[hash].js"
  },
  "snapshot": false
}
