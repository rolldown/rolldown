import { t as __esmMin } from "./rolldown-runtime.js";

// color.js
var setOpacity;
function init_color() {
	return (init_color = __esmMin((() => {
		setOpacity = (color, opacity) => `${color}:${opacity}`;
	})))();
}

// css.js
