## Assets

### main.js

```js
import { n as value, r as __esmMin, t as init_reader } from "./reader.js";
// patch.js
function init_patch() {
	return (init_patch = __esmMin((() => {
		globalThis.__orderRead = () => 42;
	})))();
}
// main.js
function init_main() {
	return (init_main = __esmMin((() => {
		init_patch();
		init_reader();
		if (value !== 42) throw new Error(`reader evaluated before patch: value = ${value}`);
	})))();
}
init_main();

```

