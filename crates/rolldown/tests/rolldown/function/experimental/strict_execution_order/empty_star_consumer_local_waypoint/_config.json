{
  "configName": "wrap-all",
  "config": {
    "input": [
      {
        "name": "main",
        "import": "./main.js"
      }
    ],
    "format": "iife",
    "codeSplitting": false,
    "shimMissingExports": true,
    "strictExecutionOrder": true
