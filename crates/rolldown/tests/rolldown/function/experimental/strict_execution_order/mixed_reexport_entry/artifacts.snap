# Assets

## main.js

```js
import { t as __esmMin } from "./rolldown-runtime.js";

// value.js
var VALUE;
function init_value() {
	return (init_value = __esmMin((() => {
		VALUE = { value: "entry" };
	})))();
}

// main.js
var LOCAL, load;
function init_main() {
	return (init_main = __esmMin((() => {
		init_value();
		LOCAL = "local";
		load = () => import("./shared.js").then((module) => module.FORWARDED);
	})))();
}

init_main();
export { LOCAL, VALUE, load };

```

## rolldown-runtime.js

```js
// HIDDEN [\0rolldown/runtime.js]
export { __esmMin as t };

```

## shared.js

```js
import { t as __esmMin } from "./rolldown-runtime.js";

// forwarded.js
var FORWARDED;
function init_forwarded() {
	return (init_forwarded = __esmMin((() => {
		FORWARDED = { value: "dynamic" };
	})))();
}

// shared.js
function init_shared() {
	return (init_shared = __esmMin((() => {
		init_forwarded();
	})))();
}

init_shared();
export { FORWARDED };

```

