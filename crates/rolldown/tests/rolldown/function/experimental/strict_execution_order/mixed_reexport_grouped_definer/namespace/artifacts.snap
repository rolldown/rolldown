# Assets

## lazy.js

```js
import { r as __esmMin, t as SNAPSHOT } from "./snapshot.js";
import { n as init_shared } from "./shared.js";
// ../pure.js
const PURE = "pure";
// lazy.js
function read() {
	return [SNAPSHOT, PURE];
}
function init_lazy() {
	return (init_lazy = __esmMin((() => {
		init_shared();
	})))();
}
init_lazy();
export { read };

```

## main.js

```js
import { r as __esmMin } from "./snapshot.js";
import { n as init_shared, t as LOCAL } from "./shared.js";
// main.js
var local, load;
function init_main() {
	return (init_main = __esmMin((() => {
		init_shared();
		globalThis.__seed = 1;
		local = LOCAL;
		load = () => import("./lazy.js").then((module) => module.read());
	})))();
}
init_main();
export { load, local };

```

## shared.js

```js
import { n as init_value, r as __esmMin } from "./snapshot.js";
// ../shared.js
var LOCAL;
function init_shared() {
	return (init_shared = __esmMin((() => {
		init_value();
		LOCAL = "local";
	})))();
}
export { init_shared as n, LOCAL as t };

```

## snapshot.js

```js
// HIDDEN [\0rolldown/runtime.js]
