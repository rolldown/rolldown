{
  "config": {
    "strictExecutionOrder": true,
    "preserveEntrySignatures": "allow-extension",
    "experimental": {
      "onDemandWrapping": true
    },
    "codeSplitting": {
      "includeDependenciesRecursively": false,
      "groups": [
        {
          "name": "snapshot",
          "test": "[\\\\/]snapshots[\\\\/]value\\.js$"
        }
      ]
    }
  },
  "configVariants": [
    {
      "_configName": "no-optimization",
      "chunkOptimization": false
    }
  ]
}
