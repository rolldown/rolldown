# Assets

## lazy.js

```js
import { t as __esmMin } from "./rolldown-runtime.js";
import { t as SNAPSHOT } from "./snapshot.js";
import { n as init_shared } from "./shared.js";
//#region ../pure.js
const PURE = "pure";
//#endregion
//#region lazy.js
function init_lazy() {
	return (init_lazy = __esmMin((() => {
		init_shared();
	})))();
}
//#endregion
init_lazy();
export { PURE, SNAPSHOT };

```

## main.js

```js
import { t as __esmMin } from "./rolldown-runtime.js";
import { n as init_shared, t as LOCAL } from "./shared.js";
//#region main.js
var local, load;
function init_main() {
	return (init_main = __esmMin((() => {
		init_shared();
		globalThis.__seed = 1;
		local = LOCAL;
		load = () => import("./lazy.js").then((module) => [module.SNAPSHOT, module.PURE]);
	})))();
}
//#endregion
init_main();
export { load, local };

```

