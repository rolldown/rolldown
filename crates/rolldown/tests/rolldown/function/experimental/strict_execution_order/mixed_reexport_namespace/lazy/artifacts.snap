# Assets

## lazy.js

```js
import { n as init_mixed, r as __esmMin, t as LOCAL } from "./mixed.js";
// ../leaf.js
var VALUE;
function init_leaf() {
	return (init_leaf = __esmMin((() => {
		VALUE = "leaf";
	})))();
}
// lazy.js
function init_lazy() {
	return (init_lazy = __esmMin((() => {
		init_leaf();
		init_mixed();
	})))();
}
init_lazy();
export { LOCAL, VALUE };

```

