{
  "config": {
    "strictExecutionOrder": true
  },
  "configVariants": [
    {
      "_configName": "no-optimization",
      "_snapshot": false,
      "chunkOptimization": false
    },
    {
      "_configName": "on-demand",
      "_snapshot": false,
      "onDemandWrapping": true
    },
    {
      "_configName": "minified-cjs",
      "_snapshot": false,
      "format": "cjs",
      "minify": true
    },
    {
      "_configName": "manual-groups",
      "_snapshot": false,
      "preserveEntrySignatures": "allow-extension",
      "codeSplitting": {
        "includeDependenciesRecursively": false,
        "groups": [
          {
            "name": "mixed",
            "test": "[\\\\/](?:mixed|mixed-default)\\.js$"
          },
          {
            "name": "leaf",
            "test": "[\\\\/](?:leaf|leaf-default)\\.js$"
          }
        ]
      }
    }
  ]
}
