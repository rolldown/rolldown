## shared.js

```js
import { t as __esmMin } from "./rolldown-runtime.js";
//#region state.js
function bump() {
	state++;
}
var state;
function init_state() {
	return (init_state = __esmMin((() => {
		state = 0;
	})))();
}
//#endregion
//#region snapshots/value.js
var SNAPSHOT;
function init_value() {
	return (init_value = __esmMin((() => {
		init_state();
		SNAPSHOT = state;
	})))();
}
//#endregion
//#region shared.js
var LOCAL;
function init_shared() {
	return (init_shared = __esmMin((() => {
		init_value();
		LOCAL = "local";
	})))();
}
//#endregion
export { bump as a, init_value as i, init_shared as n, init_state as o, SNAPSHOT as r, LOCAL as t };

```

