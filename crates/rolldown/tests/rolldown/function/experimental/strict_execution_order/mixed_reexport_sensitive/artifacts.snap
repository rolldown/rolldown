## lazy.js

```js
import { t as __esmMin } from "./rolldown-runtime.js";
import { n as init_shared, r as SNAPSHOT } from "./shared.js";
//#region pure.js
var PURE;
function init_pure() {
	return (init_pure = __esmMin((() => {
		PURE = "pure";
	})))();
}
//#endregion
//#region lazy.js
function read() {
	return [SNAPSHOT, PURE];
}
function init_lazy() {
	return (init_lazy = __esmMin((() => {
		init_pure(), init_shared();
	})))();
}
//#endregion
init_lazy();
export { read };

```

## main.js

```js
import { t as __esmMin } from "./rolldown-runtime.js";
import { a as bump, n as init_shared, o as init_state, t as LOCAL } from "./shared.js";
//#region main.js
var local, load;
function init_main() {
	return (init_main = __esmMin((() => {
		init_shared();
		init_state();
		local = LOCAL;
		bump();
		load = () => import("./lazy.js").then((module) => module.read());
	})))();
}
//#endregion
init_main();
export { load, local };

