# Assets

## lazy.js

```js
import { t as __esmMin } from "./rolldown-runtime.js";
//#region ../snapshots/value.js
var SNAPSHOT;
function init_value() {
	return (init_value = __esmMin((() => {
		SNAPSHOT = 0;
	})))();
}
//#endregion
//#region ../pure.js
const PURE = "pure";
//#endregion
//#region lazy.js
function read() {
	return [SNAPSHOT, PURE];
}
function init_lazy() {
	return (init_lazy = __esmMin((() => {
		init_value();
	})))();
}
//#endregion
init_lazy();
export { read };

```

## main.js

```js
import { t as __esmMin } from "./rolldown-runtime.js";
import { t as LOCAL } from "./shared.js";
//#region main.js
var local, load;
function init_main() {
	return (init_main = __esmMin((() => {
		local = LOCAL;
		load = () => import("./lazy.js").then((module) => module.read());
	})))();
}
//#endregion
init_main();
export { load, local };

```

