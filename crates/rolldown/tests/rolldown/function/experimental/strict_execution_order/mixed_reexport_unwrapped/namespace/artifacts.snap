# Assets

## lazy.js

```js
import { n as SNAPSHOT } from "./shared.js";
//#region ../pure.js
const PURE = "pure";
//#endregion
//#region lazy.js
function read() {
	return [SNAPSHOT, PURE];
}
//#endregion
export { read };

```

## main.js

```js
import { t as LOCAL } from "./shared.js";
//#region main.js
const local = LOCAL;
const load = () => import("./lazy.js").then((module) => module.read());
//#endregion
export { load, local };

```

## shared.js

```js
//#region ../snapshots/value.js
const SNAPSHOT = 0;
//#endregion
//#region ../shared.js
const LOCAL = "local";
//#endregion
export { SNAPSHOT as n, LOCAL as t };

```

