## mixed.js

```js
import { t as __esmMin } from "./rolldown-runtime.js";
//#region ../state.js
function mutate() {
	state = "after";
}
var state;
function init_state() {
	return (init_state = __esmMin((() => {
		state = "before";
	})))();
}
//#endregion
//#region leaf.js
var SNAPSHOT;
function init_leaf() {
	return (init_leaf = __esmMin((() => {
		init_state();
		SNAPSHOT = state;
	})))();
}
//#endregion
//#region mixed.js
function LOCAL() {
	return "local";
}
function init_mixed() {
	return (init_mixed = __esmMin((() => {
		init_leaf();
	})))();
}
//#endregion
export { init_state as a, init_leaf as i, init_mixed as n, mutate as o, SNAPSHOT as r, LOCAL as t };

```

