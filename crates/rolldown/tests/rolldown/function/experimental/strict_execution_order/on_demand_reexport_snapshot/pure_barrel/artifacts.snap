## lazy.js

```js
import { t as __esmMin } from "./rolldown-runtime.js";
import { n as init_leaf, t as SNAPSHOT } from "./leaf.js";
//#region lazy.js
function init_lazy() {
	return (init_lazy = __esmMin((() => {
		init_leaf();
	})))();
}
//#endregion
init_leaf();
init_lazy();
export { SNAPSHOT };

```

## leaf.js

```js
import { t as __esmMin } from "./rolldown-runtime.js";
//#region ../state.js
function mutate() {
	state = "after";
}
var state;
function init_state() {
	return (init_state = __esmMin((() => {
		state = "before";
	})))();
}
//#endregion
//#region leaf.js
var SNAPSHOT;
function init_leaf() {
	return (init_leaf = __esmMin((() => {
		init_state();
		SNAPSHOT = state;
	})))();
}
//#endregion
export { mutate as i, init_leaf as n, init_state as r, SNAPSHOT as t };

```

## main.js

```js
import { t as __esmMin } from "./rolldown-runtime.js";
import { i as mutate, n as init_leaf, r as init_state } from "./leaf.js";
//#region local.js
function LOCAL() {
	return "local";
}
//#endregion
//#region main.js
async function read() {
	return (await import("./lazy.js")).SNAPSHOT;
}
var result;
function init_main() {
	return (init_main = __esmMin((() => {
		init_leaf();
		init_state();
		mutate();
		result = LOCAL();
	})))();
}
//#endregion
init_main();
export { read, result };

