# Assets

## main.js

```js
import "ext";
import data from "ext" with { type: "json" };
export * from "ext" with { type: "json" };
// main.js
const lazy = () => import("ext", { with: { type: "json" } });
const lazyAssert = () => import("ext", { with: { type: "json" } });
const computed = (name) => import(name, { with: { type: "json" } });
export { computed, data, lazy, lazyAssert };

```
