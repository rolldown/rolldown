{
  "_comment": "Same-named carriers of one inlined record must get distinct import map keys. Some keys hash absolute module ids, so the output differs between checkouts and isn't snapshotted.",
  "hashInFilename": true,
  "config": {
    "input": [
      { "name": "a", "import": "./a.js" },
      { "name": "b", "import": "./b.js" },
      { "name": "c", "import": "./c.js" }
    ],
    "entryFilenames": "[name].js",
    "strictExecutionOrder": true,
    "preserveEntrySignatures": "false",
    "codeSplitting": {
      "experimentalInlineCommonChunks": { "maxSize": 128 }
    },
    "experimental": {
      "chunkImportMap": {}
    }
  },
  "snapshot": false
}
