{
  "config": {
    "input": [
      { "name": "a", "import": "./a.js" },
      { "name": "b", "import": "./b.js" }
    ],
    "strictExecutionOrder": true,
    "preserveEntrySignatures": "false",
    "codeSplitting": {
      "experimentalInlineCommonChunks": { "maxSize": 4096 },
      "groups": [
        {
          "name": "vendor",
          "test": "[\\\\/]inherited_from_dependency[\\\\/]v\\.js$",
          "includeDependenciesRecursively": false
        }
      ]
    }
  }
}
