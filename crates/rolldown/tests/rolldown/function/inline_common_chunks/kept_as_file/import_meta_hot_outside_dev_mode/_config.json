{
  "_comment": "Without `experimental.devMode`, `import.meta.hot` stays native like any other `import.meta` read; the chunk stays a file.",
  "config": {
    "input": [
      {
        "name": "a",
        "import": "./a.js"
      },
      {
        "name": "b",
        "import": "./b.js"
      }
    ],
    "strictExecutionOrder": true,
    "preserveEntrySignatures": "false",
    "codeSplitting": {
      "experimentalInlineCommonChunks": {
        "maxSize": 4096
      }
    }
  }
}
