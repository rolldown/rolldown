## shared.js

```js
// shared.js
globalThis.events.push("S body");
let count = 0;
function bump() {
	count += 1;
	return this === void 0 ? "this:undefined" : "this:bound";
}
const marker = { tag: "shared" };
export { count as n, marker as r, bump as t };

```

