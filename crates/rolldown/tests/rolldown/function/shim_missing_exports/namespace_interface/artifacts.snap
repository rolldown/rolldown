# Assets

## main.js

```js
// HIDDEN [\0rolldown/runtime.js]
//#region dep.js
var dep_exports = /* @__PURE__ */ __exportAll({
	"a-b": () => a_b,
	default: () => _default,
	missing: () => missing,
	unused: () => unused,
	value: () => 1
});
var a_b = void 0;
var _default = void 0;
var missing = void 0;
var unused = void 0;
//#endregion
//#region barrel.js
var barrel_exports = /* @__PURE__ */ __exportAll({
	"a-b": () => a_b,
	missing: () => missing,
	unused: () => unused,
	value: () => 1
});
//#endregion
//#region main.js
const values = [
	_default,
	a_b,
	missing
];
const keys = [Object.keys(dep_exports).sort(), Object.keys(barrel_exports).sort()];
const load = () => Promise.resolve().then(() => barrel_exports);
//#endregion
export { keys, load, values };

```
