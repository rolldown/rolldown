# Assets

## app.js

```js
//#region vendor.js
function f0(x) {
	return x * 2 + 1;
}
//#endregion
//#region app.js
console.log(f0(1));
const done = import("./lazy.js").then(({ fn }) => {
	fn();
});
//#endregion
export { done, f0 as t };

```

## lazy.js

```js
import { t as f0 } from "./app.js";
//#region lazy.js
function fn() {
	console.log(f0(3));
}
//#endregion
export { fn };

```

