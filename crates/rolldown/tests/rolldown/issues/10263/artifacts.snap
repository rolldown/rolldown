# Assets

## app.js

```js
// vendor.js
function f0(x) {
	return x * 2 + 1;
}

// app.js
console.log(f0(1));
const done = import("./lazy.js").then(({ fn }) => {
	fn();
});

export { done, f0 as t };

```

## lazy.js

```js
import { t as f0 } from "./app.js";

// lazy.js
function fn() {
	console.log(f0(3));
}

export { fn };

```

## main.js

```js
// main.js
const done = import("./app.js").then((app) => app.done);

export { done };

```
