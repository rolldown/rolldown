### main.js

```js
Object.defineProperty(exports, Symbol.toStringTag, { value: "Module" });
// HIDDEN [\0rolldown/runtime.js]
let ext = require("ext");
ext = __toESM(ext);
require("ext2");
Object.defineProperty(exports, "M", {
	enumerable: true,
	get: function() {
		return ext;
	}
});
Object.defineProperty(exports, "S", {
	enumerable: true,
	get: function() {
		return ext.S;
	}
});

