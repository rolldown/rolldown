# Variant: on-demand-cjs: [format: Cjs] [on_demand_wrapping: true]

## Assets

### lazy.js

```js
//#region values.js
const LAZY = "lazy";
//#endregion
//#region lazy.js
function read() {
	return LAZY;
}
//#endregion
exports.read = read;

```

### main.js

```js
Object.defineProperty(exports, Symbol.toStringTag, { value: "Module" });
//#region main.js
const local = require("./shared.js").LOCAL;
const load = () => Promise.resolve().then(() => require("./lazy.js")).then((module) => module.read());
//#endregion
exports.load = load;
exports.local = local;

```

### shared.js

```js
//#region shared.js
const LOCAL = "local";
//#endregion
Object.defineProperty(exports, "LOCAL", {
	enumerable: true,
	get: function() {
		return LOCAL;
	}
});

```

