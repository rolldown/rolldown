# Assets

## lazy.js

```js
import { t as __esmMin } from "./rolldown-runtime.js";
import { n as init_shared } from "./shared.js";
//#region values.js
var LAZY;
function init_values() {
	return (init_values = __esmMin((() => {
		LAZY = "lazy";
	})))();
}
//#endregion
//#region lazy.js
function read() {
	return LAZY;
}
function init_lazy() {
	return (init_lazy = __esmMin((() => {
		init_values(), init_shared();
	})))();
}
//#endregion
init_lazy();
export { read };

```

## main.js

```js
import { t as __esmMin } from "./rolldown-runtime.js";
import { n as init_shared, t as LOCAL } from "./shared.js";
//#region main.js
var local, load;
function init_main() {
	return (init_main = __esmMin((() => {
		init_shared();
		local = LOCAL;
		load = () => import("./lazy.js").then((module) => module.read());
	})))();
}
//#endregion
init_main();
export { load, local };

