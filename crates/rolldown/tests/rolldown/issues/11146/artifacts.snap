# Assets

## main.js

```js
import assert from "node:assert";
// HIDDEN [\0rolldown/runtime.js]
//#region server.js
var server_exports = /* @__PURE__ */ __exportAll({ FOO: () => "foo" });
//#endregion
//#region main.js
assert.throws(() => {
	server_exports.FOO = "changed";
}, TypeError);
assert.throws(() => {
	server_exports.FOO++;
}, TypeError);
assert.throws(() => {
	[server_exports.FOO] = ["changed"];
}, TypeError);
assert.throws(() => {
	for (server_exports.FOO of ["changed"]);
}, TypeError);
assert.throws(() => {
	delete server_exports.FOO;
}, TypeError);
assert.throws(() => {
	delete server_exports?.FOO;
}, TypeError);
assert.throws(() => {
	server_exports.FOO = "changed";
}, TypeError);
assert.throws(() => {
	server_exports.FOO = "changed";
}, TypeError);
assert.throws(() => {
	delete server_exports.FOO;
}, TypeError);
assert.strictEqual("foo", "foo");
//#endregion

```

