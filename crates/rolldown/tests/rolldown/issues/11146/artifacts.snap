### main.js

```js
"use strict";
// HIDDEN [\0rolldown/runtime.js]
let node_assert = require("node:assert");
node_assert = __toESM(node_assert);
//#region server.js
var server_exports = /* @__PURE__ */ __exportAll({ FOO: () => "foo" });
//#endregion
//#region main.js
node_assert.default.throws(() => {
	server_exports.FOO = "changed";
}, TypeError);
node_assert.default.throws(() => {
	server_exports.FOO++;
}, TypeError);
node_assert.default.throws(() => {
	[server_exports.FOO] = ["changed"];
}, TypeError);
node_assert.default.throws(() => {
	for (server_exports.FOO of ["changed"]);
}, TypeError);
node_assert.default.throws(() => {
	delete server_exports.FOO;
}, TypeError);
node_assert.default.throws(() => {
	delete server_exports?.FOO;
}, TypeError);
node_assert.default.throws(() => {
	server_exports.FOO = "changed";
}, TypeError);
node_assert.default.throws(() => {
	server_exports.FOO = "changed";
}, TypeError);
node_assert.default.throws(() => {
	delete server_exports.FOO;
}, TypeError);
node_assert.default.strictEqual("foo", "foo");
//#endregion

```
