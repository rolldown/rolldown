# Assets

## form.js

```js
// translations.js
var translations_default = { title: "Transfer" };
// form.js
const translations = translations_default;
const transferForm = () => ({ name: "transfer" });
let count = 0;
function increment() {
	count++;
}
export { translations_default as a, translations as i, increment as n, transferForm as r, count as t };

```

