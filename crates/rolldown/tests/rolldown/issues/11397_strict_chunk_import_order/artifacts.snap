// main.mjs
const load2 = () => import("./route2.js").then((n) => n.t);
globalThis.run = async () => {
	(await import("./page.js")).read();
	globalThis.route2 = await load2();
	const { value } = await import("./route0.js");
	return value;
};
export {};

```

