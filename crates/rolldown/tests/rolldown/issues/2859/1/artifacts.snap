# Assets

## lib.js

```js
// lib.js
const foo = "foo";
let bar = "";
bar = "bar";
var lib_default = "default";

export { bar, lib_default as default, foo };

```

## main.js

```js
import assert from "assert";

// main.js
import("./lib.js").then((exports) => assert.deepStrictEqual({ ...exports }, {
	foo: "foo",
	bar: "bar",
	default: "default"
}));

export {};

```

