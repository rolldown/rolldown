```js
// lib.js
const foo = "foo";
let bar = "";
bar = "bar";
var lib_default = "default";

Object.defineProperty(exports, "bar", {
	enumerable: true,
	get: function() {
		return bar;
	}
});
exports.default = lib_default;
exports.foo = foo;

```

