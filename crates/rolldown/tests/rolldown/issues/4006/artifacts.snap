# Assets

## main.js

```js
// a.js
/**
* default export function
*/
function a() {}

// b.js
/**
* default export class
*/
var b = class {};

// main.js
/**
* named export function
*/
function foo() {
	return a + b;
}
/**
* named export class
*/
var Bar = class {};
/**
* named export const decl
*/
var Baz = "baz";
/**
* stmt
*/
console.log(666);

export { Bar, Baz, Baz as default, foo };

```
