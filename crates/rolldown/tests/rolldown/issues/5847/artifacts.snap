# Assets

## compromise.js

```js
// compromise/nlp.js
const nlp = function() {
	console.log(666);
};
nlp.plugin = function() {
	return this;
};

// compromise/one.js
nlp.extend = function() {
	return 666;
};

// compromise/index.js
var compromise_default = nlp;

export { compromise_default as default };

```

## main.js

```js
import assert from "node:assert";

// main.js
const nlp = (await import("./compromise.js")).default;
assert.strictEqual(nlp.extend(), 666);

```
