# Assets

## dynamic.js

```js
import { n as utilityClass, t as helper } from "./main.js";

// dynamic.js
new utilityClass(helper());

```

## main.js

```js
// shared.js
function helper() {
	return "help";
}
var utilityClass = class {
	constructor(value) {
		this.value = value;
	}
};

// main.js
console.log(helper());
import("./dynamic.js");

export { utilityClass as n, helper as t };

```
