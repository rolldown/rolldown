// deep.js
function sleep(ms) {
	return new Promise((resolve) => setTimeout(resolve, ms));
}
await sleep(100);

// middle.js
const manager = {
	value: "hello",
	ready: false
};
function setup() {
	manager.ready = true;
}

// main.js
setup();

export { manager };

