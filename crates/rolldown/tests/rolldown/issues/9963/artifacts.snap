# Assets

## main.js

```js
//#region common.js
const common = "common-base";
//#endregion
//#region c1.js
const c1 = "c1:" + common;
//#endregion
//#region c2.js
const c2 = "c2:" + c1;
//#endregion
//#region c3.js
const c3 = "c3:" + c2;
//#endregion
//#region main.js
console.log(common, c1, c2, c3, [
	() => import("./r1.js"),
	() => import("./r2.js"),
	() => import("./r3.js")
]);
//#endregion
export { common as i, c2 as n, c1 as r, c3 as t };

```

