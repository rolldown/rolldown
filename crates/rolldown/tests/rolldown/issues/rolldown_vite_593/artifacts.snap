# Assets

## component.js

```js
import { n as SafeHtml, t as htmlEscape } from "./shared.js";

// safe.js
function setInnerHtml(elem, html) {
	if (html instanceof SafeHtml) elem.innerHTML = html.unwrap();
}

// component.js
var Component = class {
	constructor(name) {
		this.name = name;
	}
	render(el) {
		setInnerHtml(el, htmlEscape(this.name));
	}
};

export { Component };

```

