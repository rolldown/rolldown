## shared.js

```js
// browser.js
function isIE() {
	return compareVersions("11", "10") >= 0;
}

// safehtml.js
var SafeHtml = class {
	constructor(html) {
		this.html = html;
		this.isIE = isIE();
	}
	unwrap() {
		return this.html;
	}
};

// shared.js
function compareVersions(a, b) {
	return a > b ? 1 : a < b ? -1 : 0;
}
function htmlEscape(str) {
	return str.replace(/&/g, "&amp;").replace(/</g, "&lt;");
}

export { SafeHtml as n, htmlEscape as t };

```
