# Assets

## entry2.js

```js
"use entry2";
import { t as a } from "./shared.js";
//#region entry2.js
console.log(`a: `, a);
//#endregion

```

## main.js

```js
"use entry";
import { t as a } from "./shared.js";
//#region entry1.js
console.log(`a: `, a);
//#endregion

```

## shared.js

```js
//#region shared.js
const a = "shared.js";
//#endregion
export { a as t };

```
