## main.js

```js
// main.js
function dy(path) {
	switch (path) {
		case "./foo.js": return import("./foo.js");
		case "./bar.js": return import("./bar.js");
	}
}
const { msg } = await dy(`./foo.js`);
console.log(msg);
import(`https://localhost`).catch((mod) => {
	console.log(mod);
});

```
