## router.js

```js
// router.mjs
const createRouter = (page) => {
	let readyResolve;
	const isReady = new Promise((_r) => {
		readyResolve = _r;
	});
	page().then(() => readyResolve());
	return { isReady };
};

export { createRouter as t };

```
