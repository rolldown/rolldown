# Assets

## main.js

```js
"use client";
import { MyPage } from "./mod.js";
//#region main.js
console.log(MyPage);
//#endregion

```

## mod.js

```js
"use client";
//#region mod.js
function MyPage() {
	return null;
}
//#endregion
export { MyPage };

```
