import { __esmMin } from "./rolldown-runtime.js";
//#region dep.js
function dep() {
	return "D";
}
function init_dep() {
	return (init_dep = __esmMin((() => {
		globalThis.__events.push("dep");
	})))();
}
//#endregion
init_dep();
export { dep as default, init_dep };

```

## lazy.js

```js
import { __esmMin } from "./rolldown-runtime.js";
//#region lazy.js
var lazy;
