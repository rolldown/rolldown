source: crates/rolldown_testing/src/integration_test.rs
---
# warnings

## INVALID_OPTION

```text
[INVALID_OPTION] `preserveEntrySignatures: 'allow-extension'` is set implicitly by Rolldown

- `codeSplitting.includeDependenciesRecursively = false` requires `preserveEntrySignatures` to be either `false` or 'allow-extension'

To fix:

- Set `preserveEntrySignatures` either to `false` or 'allow-extension' in your config

```

# Assets

## dep.js

```js
// dep.js
const foreign = 5;
export { foreign };

```

## group.js

```js
import { n as __reExport, t as __exportAll } from "./rolldown-runtime.js";
// barrel.js
var barrel_exports = /* @__PURE__ */ __exportAll({}, 2);
import * as import_ext from "ext";
__reExport(barrel_exports, import_ext);

```

## rolldown-runtime.js

```js
// HIDDEN [\0rolldown/runtime.js]
export { __reExport as n, __exportAll as t };

```

## seg.js

```js
export { foreign } from "./dep.js";
import "./group.js";
export { change, value } from "ext";

```

# Variant: cjs

## warnings

### INVALID_OPTION

```text
[INVALID_OPTION] `preserveEntrySignatures: 'allow-extension'` is set implicitly by Rolldown

- `codeSplitting.includeDependenciesRecursively = false` requires `preserveEntrySignatures` to be either `false` or 'allow-extension'

To fix:

- Set `preserveEntrySignatures` either to `false` or 'allow-extension' in your config

```

## Assets

### dep.js

```js
Object.defineProperty(exports, Symbol.toStringTag, { value: "Module" });
// dep.js
const foreign = 5;
exports.foreign = foreign;

```

### group.js

```js
const require_rolldown_runtime = require("./rolldown-runtime.js");
// barrel.js
var barrel_exports = /* @__PURE__ */ require_rolldown_runtime.__exportAll({}, 2);
require_rolldown_runtime.__reExport(barrel_exports, require("ext"));
Object.defineProperty(exports, "barrel_exports", {
	enumerable: true,
	get: function() {
		return barrel_exports;
	}
});

```

### rolldown-runtime.js

```js
// HIDDEN [\0rolldown/runtime.js]
Object.defineProperty(exports, "__exportAll", {
	enumerable: true,
	get: function() {
		return __exportAll;
	}
});
Object.defineProperty(exports, "__reExport", {
	enumerable: true,
	get: function() {
		return __reExport;
	}
});

```

### seg.js

```js
const require_dep = require("./dep.js");
const require_group = require("./group.js");
Object.defineProperty(exports, "change", {
	enumerable: true,
	get: function() {
		return require_group.barrel_exports.change;
	}
});
exports.foreign = require_dep.foreign;
Object.defineProperty(exports, "value", {
	enumerable: true,
	get: function() {
		return require_group.barrel_exports.value;
	}
});

```

