### seg.js

```js
const require_app = require("./app.js");
const require_dep = require("./dep.js");
require("./group.js");
var first = require_app.import_counter;
try {
	first = first.n;
} catch (e) {
	first = void 0;
}
exports.first = first;
exports.foreign = require_dep.foreign;

```
