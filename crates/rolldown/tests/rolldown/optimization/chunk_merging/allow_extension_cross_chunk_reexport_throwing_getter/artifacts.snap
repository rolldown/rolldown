### seg.js

```js
const require_dep = require("./dep.js");
const require_group = require("./group.js");
var first;
try {
	first = require_group.import_counter.n;
} catch (e) {}
var x;
try {
	x = require_group.import_lib.x;
} catch (e) {}
exports.first = first;
exports.foreign = require_dep.foreign;
exports.own = require_group.own;
exports.second = first;
exports.x = x;

