# Assets

## app.js

```js
//#region app.js
const own = require("./shared.js").compute(21) + 1;
const done = Promise.resolve().then(() => require("./lazy.js")).then((m) => m.lazyValue);
//#endregion
exports.done = done;
exports.own = own;
var primitive = require("primitive");
Object.keys(primitive).forEach(function(k) {
	if (k !== "default" && !Object.prototype.hasOwnProperty.call(exports, k)) Object.defineProperty(exports, k, {
		enumerable: true,
		get: function() {
			return primitive[k];
		}
	});
});

```

