## entry.js

```js
// library/family-a.js
function eagerValueA() {
	return "value-a";
}

// library/family-b.js
function eagerValueB() {
	return "value-b";
}

// library/index.js
(globalThis.fixtureLog ??= []).push("initialize");
globalThis.fixtureInitialized = true;

// eager-consumer.js
(globalThis.fixtureLog ??= []).push(`eager:${eagerValueB()}`);

// entry.js
(globalThis.fixtureLog ??= []).push(`entry:${eagerValueA()}`);
async function loadPart(part) {
	if (part === "a") return import("./lazy-consumer-a.js");
	if (part === "b") return import("./lazy-consumer-b.js");
	return import("./lazy-consumer-c.js");
}

export { loadPart };

```

