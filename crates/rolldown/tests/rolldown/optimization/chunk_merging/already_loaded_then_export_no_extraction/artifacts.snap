# Assets

## app.js

```js
import { t as compute } from "./shared.js";

// app.js
const own = compute(3);
const lazyLoaded = import("./lazy.js").then((m) => m.lazyValue);
function then(resolve) {
	resolve(lazyLoaded);
}

export { lazyLoaded, own, then };

```

## lazy.js

```js
import { t as compute } from "./shared.js";

// lazy.js
const lazyValue = compute(7);

export { lazyValue };

```

## main.js

```js
// main.js
const result = import("./app.js");

export { result };

```

## shared.js

```js
// shared.js
function compute(x) {
	return x * 2;
}

export { compute as t };

```
