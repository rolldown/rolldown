import { t as __esmMin } from "./rolldown-runtime.js";
import { t as init_library } from "./library.js";
//#region library/heavy.js
function heavyValue() {
	return `${HEAVY_MARKER}:${HEAVY_PAYLOAD}`;
}
var HEAVY_MARKER, HEAVY_PAYLOAD;
function init_heavy() {
	return (init_heavy = __esmMin((() => {
		HEAVY_MARKER = "heavy-marker";
		HEAVY_PAYLOAD = "heavy-payload-01:heavy-payload-02:heavy-payload-03:heavy-payload-04:heavy-payload-05:heavy-payload-06:heavy-payload-07:heavy-payload-08";
	})))();
}
//#endregion
//#region heavy-consumer.js
