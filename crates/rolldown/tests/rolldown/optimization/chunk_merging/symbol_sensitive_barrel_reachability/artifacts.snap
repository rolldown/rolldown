## heavy-consumer.js

```js
import "./library.js";
//#region library/heavy.js
const HEAVY_MARKER = "heavy-marker";
const HEAVY_PAYLOAD = "heavy-payload-01:heavy-payload-02:heavy-payload-03:heavy-payload-04:heavy-payload-05:heavy-payload-06:heavy-payload-07:heavy-payload-08";
function heavyValue() {
	return `${HEAVY_MARKER}:${HEAVY_PAYLOAD}`;
}
//#endregion
//#region heavy-consumer.js
globalThis.fixtureLog.push(`consumer-heavy:${heavyValue()}`);
const value = heavyValue();
//#endregion
export { value };

```

