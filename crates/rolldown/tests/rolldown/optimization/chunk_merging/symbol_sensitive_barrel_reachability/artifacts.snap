function init_heavy_consumer() {
	return (init_heavy_consumer = __esmMin((() => {
		init_library(), init_heavy();
		globalThis.fixtureLog.push(`consumer-heavy:${heavyValue()}`);
		value = heavyValue();
	})))();
}
//#endregion
init_heavy_consumer();
export { value };

```

