require_property();
require_shadowed();
assert.strictEqual(import_assignment.x ? "truthy" : "falsy", "falsy");
assert.strictEqual(import_destructuring.x ? "truthy" : "falsy", "falsy");
assert.strictEqual(import_logical_assignment.x ? "truthy" : "falsy", "falsy");
assert.strictEqual(import_loop.x ? "truthy" : "falsy", "falsy");
assert.strictEqual(import_nested.x ? "truthy" : "falsy", "falsy");
assert.strictEqual("truthy", "truthy");
assert.strictEqual("truthy", "truthy");
