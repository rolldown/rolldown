# Assets

## flags.js

```js
// flags.js
const DEV = false;
const PROD = true;
let mutable = false;
mutable = globalThis.mutable;
const object = { toString() {
	console.log("COERCION");
	return "";
} };
export { DEV, PROD, mutable, object };

