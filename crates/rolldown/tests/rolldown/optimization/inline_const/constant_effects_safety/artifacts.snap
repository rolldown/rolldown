## main.js

```js
import { mutable, object } from "./flags.js";
// main.js
if (console.log("TEST_EFFECT"), false);
console.log("LIVE_ELSE");
console.log("LIVE_TRUE");
if (mutable) console.log("MUTABLE");
`${object}`;

```
