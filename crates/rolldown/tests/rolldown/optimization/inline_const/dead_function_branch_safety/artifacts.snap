## a.js

```js
import { a as enable, i as object, n as live, o as mutable, r as mutableHelper, t as dead } from "./internal.js";

//#region effect.js
globalThis.branchEffects.push("import");

//#endregion
//#region a.js
function a() {
	{
		globalThis.branchEffects.push("test"), false;
	}
	{}
	{
		globalThis.branchEffects.push("live branch");
	}
	0, false;
	0, true;
	0, true;
	null ?? globalThis.branchEffects.push("nullish");
	globalThis.branchEffects.push((false, "ternary"));
	if (mutable) return mutableHelper();
	return live();
}
function hoisted() {
	if (false) var value = dead();
	return value;
}
function shadowed(DEV) {
	if (DEV) return live();
	return "shadowed";
}
function indirectLogical() {
	return (object.method || (0, false))();
}
function indirectConditional() {
	return (true, object.method)();
}
function throwingCondition() {
	{
		(() => {
			throw new Error("condition");
		})(), false;
	}
}
function nested(outer) {
	if (outer) {
		{
			return "nested";
		}
	}
	return "neither";
}
function lexical() {
	const value = "outer";
	{
		globalThis.branchEffects.push("inner");
	}
	return value;
}

//#endregion
export { a, enable, hoisted, indirectConditional, indirectLogical, lexical, nested, shadowed, throwingCondition };
```

