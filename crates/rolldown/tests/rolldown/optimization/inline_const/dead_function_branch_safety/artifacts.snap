## internal.js

```js
//#region env.js
let mutable = false;
function enable() {
	mutable = true;
}

//#endregion
//#region internal.js
function dead() {
	throw new Error("dead helper retained");
}
function live() {
	return "live";
}
function mutableHelper() {
	return "mutable";
}
const object = { method() {
	return this;
} };

//#endregion
export { enable as a, object as i, live as n, mutable as o, mutableHelper as r, dead as t };
```

