// main.js
function ifStatement() {
	if (+({ __proto__: { toString: () => "1" } } + "")) return "consequent";
	return "fallthrough";
}
function conditional() {
	return +({ __proto__: { toString: () => "1" } } + "") ? "consequent" : "alternate";
}
function logical() {
	return +({ __proto__: { toString: () => "1" } } + "") && "right";
}
if (+({ __proto__: { toString: () => "1" } } + "")) globalThis.topLevel = "consequent";
else globalThis.topLevel = "alternate";

export { conditional, ifStatement, logical };
