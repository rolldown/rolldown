# Assets

## a.js

```js
//#region errors.js
function oops(values) {
	{}
	throw new Error("https://example.com/oops");
}

//#endregion
//#region forms.js
function forms() {
	0, false;
	0, !false;
	0, false;
	return false, "production";
}

//#endregion
//#region a.js
function a(name) {
	if (!name) oops({ name: "a" });
	return name;
}

//#endregion
export { a, forms };
```

## b.js

```js
//#region warnings.js
function careful(values) {
	{
		console.warn("https://example.com/careful");
	}
}

//#endregion
//#region b.js
function b(name) {
	if (!name) careful({ name: "b" });
	return name;
}

//#endregion
export { b };
```

