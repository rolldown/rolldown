### internal.js

```js
//#region env.js
const DEV = false;

//#endregion
//#region internal.js
const bold = "font-weight: bold";
function throw_error(code, message) {
	const error = /* @__PURE__ */ new Error(`${code}\n${message}\nhttps://example.com/${code}`);
	error.name = "Rich error";
	throw error;
}

//#endregion
export { throw_error as n, DEV as r, bold as t };
