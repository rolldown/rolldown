# Variant: no-treeshake: [treeshake: Boolean(false)]

## Assets

### a.js

```js
import { n as throw_error, t as bold } from "./internal.js";

//#region errors.js
function oops(values) {
	if (false) {
		throw_error("oops", `Something went wrong with ${values.name}`);
	}
	throw new Error("https://example.com/oops");
}

//#endregion
//#region forms.js
function forms() {
	false && throw_error("and", "dead");
	!false || throw_error("or", "dead");
	false ?? throw_error("nullish", "dead");
	return false ? bold : "production";
}

//#endregion
//#region a.js
function a(name) {
	if (!name) oops({ name: "a" });
	return name;
}

//#endregion
export { a, forms };
```

### b.js

```js
import { t as bold } from "./internal.js";

//#region warnings.js
function careful(values) {
	if (false) {
		console.warn(`%c careful ${values.name}`, bold);
	} else {
		console.warn("https://example.com/careful");
	}
}

//#endregion
//#region b.js
function b(name) {
	if (!name) careful({ name: "b" });
	return name;
}

//#endregion
export { b };
```

### internal.js

```js
//#region env.js
const DEV = false;

//#endregion
//#region internal.js
const bold = "font-weight: bold";
function throw_error(code, message) {
	const error = new Error(`${code}\n${message}\nhttps://example.com/${code}`);
	error.name = "Rich error";
	throw error;
}

//#endregion
export { throw_error as n, bold as t };
```

