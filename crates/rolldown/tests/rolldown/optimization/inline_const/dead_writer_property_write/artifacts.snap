# Assets

## main.js

```js
// flag.js
let flag = false;
const api = {};
api.enable = () => {
	flag = true;
};
function run() {
	api.enable();
}

// registry.js
const registry = {};

// imported-flag.js
let imported = false;
registry.enable = () => {
	imported = true;
};
function run_imported() {
	registry.enable();
}

// main.js
function read() {
	run();
	run_imported();
	return [
		flag,
		imported,
		false
	];
}

export { read };
```
