# Assets

## main.js

```js
import assert from "node:assert";
// b.js
const early = [
	v,
	defaultValue,
	__proto__
];
// main.js
var v = 3;
var defaultValue = 4;
var __proto__ = 5;
assert.deepStrictEqual(early, [
	void 0,
	void 0,
	void 0
]);
assert.deepStrictEqual([
	v,
	defaultValue,
	__proto__
], [
	3,
	4,
	5
]);
export { __proto__, defaultValue as default, v };

```

