# Assets

## main.js

```js
import assert from "node:assert";
// main.js
const reads = [flag];
const errors = [];
try {
	run();
} catch (error) {
	errors.push(error.name);
}
var flag = true;
var run = () => {};
assert.deepStrictEqual(reads, [void 0]);
assert.deepStrictEqual(errors, ["TypeError"]);
export { flag, run };

```

