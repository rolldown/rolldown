# Assets

## main.js

```js
Object.defineProperty(exports, Symbol.toStringTag, { value: "Module" });
// HIDDEN [\0rolldown/runtime.js]
let sheet = require("sheet");
let data = require("data");
let named = require("named");
sheet = __toESM(sheet);
data = __toESM(data);
// main.js
console.log(sheet.default, data.default, 1, import("lazy", { with: { type: "css" } }));
Object.defineProperty(exports, "named", {
	enumerable: true,
	get: function() {
		return named.named;
	}
});

```

