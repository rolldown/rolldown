```js
import { n as __exportAll, t as __deferNs } from "./rolldown-runtime.js";
// local.json
var local_exports = /* @__PURE__ */ __exportAll({
	d: () => d,
	default: () => local_default
});
var local_deferred = /* @__PURE__ */ __deferNs(() => local_exports, local_exports);
var d = true;
var local_default = { d };
// main.js
const entries = (ns) => Object.keys(ns).map((key) => [key, ns[key]]);
const compare = (eager, deferred, eagerAgain) => ({
	eager: entries(eager),
	deferred: entries(deferred),
	sameEager: eager === eagerAgain,
	distinctDeferred: deferred !== eager
});
async function run() {
	const firstEager = await import("./first.js").then((n) => n.n);
	const firstDeferred = await (async (n) => (n = await import("./first.js"), n.t))();
	const firstEagerAgain = await import("./first.js").then((n) => n.n);
	const secondDeferred = await (async (n) => (n = await import("./second.js"), n.t))();
	const secondEager = await import("./second.js").then((n) => n.n);
	const secondEagerAgain = await import("./second.js").then((n) => n.n);
	const localEager = await Promise.resolve().then(() => local_exports);
	const localDeferred = await (async () => local_deferred)();
	const localEagerAgain = await Promise.resolve().then(() => local_exports);
	return {
		first: compare(firstEager, firstDeferred, firstEagerAgain),
		second: compare(secondEager, secondDeferred, secondEagerAgain),
		local: {
			...compare(localEager, localDeferred, localEagerAgain),
			static: local_deferred === localDeferred
		}
	};
}
export { run };

