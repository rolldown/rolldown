# warnings

## INEFFECTIVE_DYNAMIC_IMPORT

```text
[INEFFECTIVE_DYNAMIC_IMPORT] d.js is dynamically imported by c.js but also statically imported by e.js, dynamic import will not move module into another chunk.

```

# Assets

## all.js

```js
// HIDDEN [\0rolldown/runtime.js]
// log.js
var log;
function init_log() {
	return (init_log = __esmMin((() => {
		log = [];
	})))();
}
// d.js
var d_exports = /* @__PURE__ */ __exportAll({ x: () => 1 });
var d_deferred = /* @__PURE__ */ __deferNs(() => (init_d(), d_exports), d_exports);
function init_d() {
	return (init_d = __esmMin((() => {
		init_log();
		log.push("d");
	})))();
}
// c.js
const p = (async () => d_deferred)();
// e.js
const read = () => (init_d(), 1);
export { log as a, init_log as i, d_deferred as n, p as o, init_d as r, read as t };

```

## main.js

```js
import { a as log, i as init_log, n as d_deferred, o as p, t as read } from "./all.js";
// main.js
init_log();
async function run() {
	const value = await p;
	return {
		same: value === d_deferred,
		tag: Object.prototype.toString.call(value)
	};
}
export { log, read, run };

