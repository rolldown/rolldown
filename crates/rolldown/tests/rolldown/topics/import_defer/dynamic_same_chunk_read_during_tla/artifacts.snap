## main.js

```js
import { c as early, i as d_deferred, l as p, r as data_deferred, s as seenAfterPause, u as pj } from "./all.js";
// main.js
const tag = (value) => Object.prototype.toString.call(value);
async function run() {
	const value = await p;
	const json = await pj;
	return {
		same: value === d_deferred,
		tag: tag(value),
		jsonSame: json === data_deferred,
		jsonTag: tag(json)
	};
}
export { early, run, seenAfterPause };

