import { n as __esmDefer, t as init_x } from "./x.js";
// log.js
const log = [];
function read(access) {
	try {
		access();
		return "ok";
	} catch (error) {
		return error instanceof TypeError ? "TypeError" : `${error.constructor.name}: ${error.message}`;
	}
}
// main.js
log.push("main: " + read(() => (__esmDefer(init_x), 1)));
const done = import("./j.js").then(() => log.push("j runs"), (error) => log.push("j throws: " + error.message));
export { done, log };

```

