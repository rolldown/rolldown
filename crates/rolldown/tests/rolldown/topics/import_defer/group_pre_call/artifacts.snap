// HIDDEN [\0rolldown/runtime.js]
// log.js
var log;
function init_log() {
	return (init_log = __esmState((() => {
		log = [];
	}), () => []))(arguments[0]);
}
// shared.js
function init_shared() {
	return (init_shared = __esmState((() => {
		init_log(init_shared);
		log.push("shared");
	}), () => [init_log]))(arguments[0]);
}
// member.js
function init_member() {
	return (init_member = __esmState((() => {
		init_log(init_member);
		log.push("member");
	}), () => [init_log]))(arguments[0]);
}
function init_first() {
	return (init_first = __esmState((() => {
		init_log(init_first);
		init_shared(init_first);
		init_member(init_first);
		log.push("first");
	}), () => [
		init_log,
		init_shared,
		init_member
	]))(arguments[0]);
}
function init_second() {
	return (init_second = __esmState((() => {
		init_log(init_second);
		init_shared(init_second);
		log.push("second");
	}), () => [init_log, init_shared]))(arguments[0]);
}
// main.js
init_log();
function run() {
	return [
		(__esmDefer(init_first), 1),
		(__esmDefer(init_second), 2),
		...log
	];
}
export { run };

