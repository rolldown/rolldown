## main.js

```js
import { n as log, t as init_log } from "./log.js";
// main.js
init_log();
const result = (async () => {
	const { ns } = await import("./importer.js");
	log.push("after import(importer)");
	let err1, err2;
	await import("./d.js").then((n) => (n.r(), n.n)).catch((e) => {
		err1 = e;
	});
	try {
		ns.value;
	} catch (e) {
		err2 = e;
	}
	return [err1?.message, err1 === err2];
})();
export { log, result };

```

