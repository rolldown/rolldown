(function(global, factory) {
	typeof exports === "object" && typeof module !== "undefined" ? factory(exports, require("ext-inner"), require("ext-lazy"), require("node:path"), require("ext-eager")) : typeof define === "function" && define.amd ? define([
		"exports",
		"ext-inner",
		"ext-lazy",
		"node:path",
		"ext-eager"
	], factory) : (global = typeof globalThis !== "undefined" ? globalThis : global || self, factory(global.lib = {}, global.ExtInner, global.ExtLazy, global.NodePath, global.ExtEager));
})(this, function(exports, ext_inner, ext_lazy, node_path, ext_eager) {
	Object.defineProperty(exports, Symbol.toStringTag, { value: "Module" });
	// d.js
	const x = [ext_lazy.value, node_path.join];
	// main.js
