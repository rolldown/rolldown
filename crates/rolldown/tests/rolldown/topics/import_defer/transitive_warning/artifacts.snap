## Assets

### main.js

```js
var lib = (function(exports, ext_lazy, node_path) {
	Object.defineProperty(exports, Symbol.toStringTag, { value: "Module" });
	// HIDDEN [\0rolldown/runtime.js]
	// inner.js
	function init_inner() {
		return (init_inner = __esmMin((() => {})))();
	}
	// d.js
	var x;
	function init_d() {
		return (init_d = __esmMin((() => {
			init_inner();
			x = [ext_lazy.value, node_path.join];
		})))();
	}
	// main.js
	const read = () => (init_d(), x);
	exports.read = read;
	return exports;
})({}, ExtLazy, NodePath);

```

