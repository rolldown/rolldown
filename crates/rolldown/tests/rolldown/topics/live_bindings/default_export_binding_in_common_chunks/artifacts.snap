# Assets

## async-entry.js

```js
import assert from "node:assert";

// shared.js
let count = 0;
function reset() {
	count = 0;
}
function inc() {
	count += 1;
}

// async-entry.js
reset();
assert.strictEqual(count, 0);
assert.strictEqual(count, count);
inc();
assert.strictEqual(count, 1);
assert.strictEqual(count, count);

```

## main.js

```js
// main.js
import("./async-entry.js");

```
