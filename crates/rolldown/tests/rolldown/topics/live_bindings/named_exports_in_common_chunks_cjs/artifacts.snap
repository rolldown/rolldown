## main.js

```js
Object.defineProperty(exports, Symbol.toStringTag, { value: "Module" });

// shared.js
let count = 0;
function reset() {
	count = 0;
}
function inc() {
	count += 1;
}

// main.js
Promise.resolve().then(() => require("./async-entry.js"));

Object.defineProperty(exports, "count", {
	enumerable: true,
	get: function() {
		return count;
	}
});
exports.inc = inc;
exports.reset = reset;

```
