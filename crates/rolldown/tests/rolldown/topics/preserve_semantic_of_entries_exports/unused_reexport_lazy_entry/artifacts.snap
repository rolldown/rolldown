# Assets

## d.js

```js
import { t as q } from "./w.js";
// d.js
globalThis.entryLog.push(`d runs ${q()}`);
const d = 1;
export { d };

```

## main.js

```js
export { t as q } from "./w.js";
// main.js
(globalThis.entryLog ??= []).push("entry runs");
globalThis.loadD = () => import("./d.js");

```

## w.js

```js
// w.js
function q() {
	return "q";
}
export { q as t };

```

