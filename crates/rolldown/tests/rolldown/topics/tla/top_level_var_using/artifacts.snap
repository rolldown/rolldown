# Assets

## main.js

```js
// log.js
const log = [];
// main.js
using syncResource = { [Symbol.dispose]() {
	log.push("sync disposed");
} };
await using asyncResource = { async [Symbol.asyncDispose]() {
	await Promise.resolve();
	log.push("async disposed");
} };
log.push("body", typeof syncResource, typeof asyncResource);
export { log };

```

## referenced.js

```js
// referenced.js
const log = [];
using syncResource = {
	kind: "sync",
	[Symbol.dispose]() {
		log.push("sync disposed");
	}
};
await using asyncResource = {
	kind: "async",
	async [Symbol.asyncDispose]() {
		await Promise.resolve();
		log.push("async disposed");
	}
};
const getSync = () => syncResource;
const getAsync = () => asyncResource;
export { getAsync, getSync, log };

```

