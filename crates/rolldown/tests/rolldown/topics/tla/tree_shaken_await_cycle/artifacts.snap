// utils.js
let relative = (s) => s;
(globalThis.tlaOrder ??= []).push("utils");
function clean(s) {
	return relative(s);
}
// fetch.js
(globalThis.tlaOrder ??= []).push("fetch");
// page.js
(globalThis.tlaOrder ??= []).push("page");
function render_page() {
	return clean("page");
}
// respond.js
