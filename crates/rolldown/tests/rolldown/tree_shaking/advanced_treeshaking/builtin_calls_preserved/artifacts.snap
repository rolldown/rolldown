// main.js
globalThis.log = [];
const log = (msg) => globalThis.log.push(msg);
const convert = (msg) => ({
	valueOf() {
		log(msg);
		return 1;
	},
	toString() {
		log(msg);
		return "x";
	}
});
"abc".at(convert("LIVE_string_argument"));
"a".concat(convert("LIVE_concat_argument"));
"x".replace({ [Symbol.replace]() {
	log("LIVE_symbol_replace");
	return "";
} }, "y");
"x".replace("x", () => {
	log("LIVE_replace_callback");
	return "y";
});
/x/.test(convert("LIVE_regexp_argument"));
try {
	123 .toString(1);
} catch {
	log("LIVE_radix_throw");
}
try {
	123 .toFixed(101);
} catch {
	log("LIVE_to_fixed_throw");
}
try {
	"x".repeat(-1);
} catch {
	log("LIVE_repeat_throw");
}
try {
	Symbol({ toString() {
		throw new Error("description");
	} });
} catch {
	log("LIVE_symbol_throw");
}
({ hasOwnProperty() {
	log("LIVE_own_method");
	return true;
} }).hasOwnProperty();
({ __proto__: { hasOwnProperty() {
	log("LIVE_proto_method");
	return false;
} } }).hasOwnProperty();
const frozen = {
	a: 1,
	nested: { a: 1 }
};
Object.freeze(frozen);
try {
	frozen.a = 2;
} catch {
	log("LIVE_frozen_write");
}
try {
	frozen.b = 2;
} catch {
	log("LIVE_frozen_add");
}
try {
	delete frozen.a;
} catch {
	log("LIVE_frozen_delete");
}
frozen.nested.a = 2;
if (frozen.nested.a === 2) log("LIVE_freeze_shallow");
const frozenArray = [1];
Object.freeze(frozenArray);
try {
	frozenArray.push(2);
} catch {
	log("LIVE_frozen_push");
}
const frozenRead = { a: "LIVE_frozen_read" };
Object.freeze(frozenRead);
log(frozenRead.a);
const re = /x/g;
re.test("x");
if (re.lastIndex === 1) log("LIVE_regexp_state");
const done = true;
export { done };

