};
var ChildOfGetter = class extends ParentGetter {};
ChildOfGetter.v;
function FnDefined() {}
Object.defineProperty(FnDefined, "a", { get() {
	log("LIVE_fn_getter");
} });
FnDefined.a;
function FnProto() {}
FnProto.__proto__ = { get a() {
	log("LIVE_fn_proto_getter");
} };
FnProto.a;
var ByName = class ByName {
	static flag = false;
	static enable() {
		ByName.flag = true;
	}
};
ByName.enable();
if (ByName.flag) log("LIVE_static_by_name");
var ByThis = class {
	static flag = false;
	static enable() {
		this.flag = true;
	}
};
ByThis.enable();
if (ByThis.flag) log("LIVE_static_by_this");
var ByArrow = class {
	static flag = false;
	static enable = () => {
		this.flag = true;
	};
};
ByArrow.enable();
if (ByArrow.flag) log("LIVE_static_by_arrow");
var ByBlock = class {
	static flag = false;
