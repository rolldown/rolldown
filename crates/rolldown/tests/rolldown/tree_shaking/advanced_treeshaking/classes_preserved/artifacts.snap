// main.js
globalThis.log = [];
const log = (msg) => globalThis.log.push(msg);
const attempt = (name, run) => {
	const call = run;
	try {
		call();
	} catch {
		log(name);
	}
};
var StaticSetter = class {
	static set v(x) {
		log("LIVE_static_setter");
	}
	static {
		this.v = 1;
	}
};
var ParentSetter = class {
	static set v(x) {
		log("LIVE_parent_setter");
	}
};
var ChildOfSetter = class extends ParentSetter {
	static {
		this.v = 1;
	}
};
var InstanceSetter = class {
	set v(x) {
		log("LIVE_instance_setter");
	}
	constructor() {
		this.v = 1;
	}
};
new InstanceSetter();
function Es5Replaced() {
	this.v = 1;
}
Es5Replaced.prototype = { set v(x) {
	log("LIVE_es5_setter");
} };
new Es5Replaced();
function Es5Defined() {
	this.v = 1;
}
Object.defineProperty(Es5Defined.prototype, "v", { set(x) {
	log("LIVE_es5_define_setter");
} });
new Es5Defined();
