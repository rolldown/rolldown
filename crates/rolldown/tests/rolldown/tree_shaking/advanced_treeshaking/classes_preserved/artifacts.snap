		this.flag = true;
	}
};
if (ByBlock.flag) log("LIVE_static_by_block");
var ByConstructor = class {
	static flag = false;
	enable() {
		this.constructor.flag = true;
	}
};
ByConstructor.prototype.enable();
if (ByConstructor.flag) log("LIVE_by_constructor");
const ByInnerName = class Inner {
	static flag = false;
