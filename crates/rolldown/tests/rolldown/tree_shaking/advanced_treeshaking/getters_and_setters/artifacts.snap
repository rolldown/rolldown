// main.js
globalThis.log = [];
const log = (msg) => globalThis.log.push(msg);
const loud = { get debug() {
	log("getter");
	return false;
} };
function main() {
	if (loud.debug);
	return 1;
}
async function load() {
	return 1;
}
export { load, main };

