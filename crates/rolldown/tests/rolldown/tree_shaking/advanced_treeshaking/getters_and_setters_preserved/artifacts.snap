# Assets

## main.js

```js
// main.js
globalThis.log = [];
const log = (msg) => globalThis.log.push(msg);
const viaThis = {
	flag: false,
	get on() {
		this.flag = true;
		return 1;
	}
};
viaThis.on;
if (viaThis.flag) log("LIVE_getter_this");
let seen = false;
({ get value() {
	seen = true;
	return 1;
} }).value;
if (seen) log("LIVE_getter_binding_write");
let state = false;
const changing = { get value() {
	return state;
} };
state = true;
if (changing.value) log("LIVE_getter_state");
const throws = {
	get value() {
		throw new Error("LIVE_getter_throw");
	},
	set value(v) {
		throw new Error("LIVE_setter_throw");
	}
};
try {
	throws.value;
} catch (error) {
	log(error.message);
}
try {
	throws.value = 1;
} catch (error) {
	log(error.message);
}
let setSeen = false;
const setter = {
	flag: false,
	set value(v) {
		setSeen = v;
	},
	set self(v) {
		this.flag = v;
	}
};
setter.value = true;
if (setSeen) log("LIVE_setter_write");
setter.self = true;
if (setter.flag) log("LIVE_setter_this");
const getterOnly = { get value() {
	return 1;
} };
try {
	getterOnly.value = 2;
} catch {
	log("LIVE_getter_only_write");
}
const overwritten = {
	a: "LIVE_overwrite_value",
	get b() {
		log("LIVE_overwrite_getter");
		return 2;
	}
};
log(overwritten.a);
overwritten.b;
const done = true;
export { done };

```
