# Assets

## main.js

```js
// main.js
globalThis.log = [];
const log = (msg) => globalThis.log.push(msg);
const attempt = (name, run) => {
	const call = run;
	try {
		call();
	} catch {
		log(name);
	}
};
function early() {
	function read() {
		return flag;
	}
	if (read()) log("never");
	const flag = false;
}
attempt("LIVE_tdz_closure", early);
function hoistedEarly() {
	if (read()) log("never");
	const flag = false;
	function read() {
		return flag;
	}
}
attempt("LIVE_tdz_hoisted", hoistedEarly);
function viaCallback() {
	const read = () => flag;
	[1].forEach(() => {
		if (read()) log("never");
	});
	const flag = false;
}
attempt("LIVE_tdz_callback", viaCallback);
function typeofEarly() {
	if (typeof flag === "boolean") log("never");
	const flag = false;
}
attempt("LIVE_tdz_typeof", typeofEarly);
const settings = { off: false };
function clause(kind) {
	switch (kind) {
		case 0:
			const flag = settings.off;
			break;
		default: if (flag) log("never");
	}
}
attempt("LIVE_case_clause", () => clause(1));
function written() {
	let flag = false;
	const set = () => {
		flag = true;
	};
	set();
	if (flag) log("LIVE_let_write");
}
written();
function late() {
	log("LIVE_closure_value");
}
late();
const done = true;
export { done };

```
