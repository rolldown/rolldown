# Assets

## main.js

```js
// tla.js
let ready = false;
const state = { ready: false };
let value;
function late() {
	return value;
}
await null;
ready = true;
state.ready = true;
value = "set";
// eval.js
const secret = { flag: false };
function run() {
	eval("secret.flag = true");
	if (secret.flag) globalThis.log.push("LIVE_eval_write");
}
const viaEval = {
	a: "LIVE_eval_read",
	b: 1
};
function readEval() {
	return eval("viaEval.a");
}
let evalFlag = false;
eval("evalFlag = true");
// main.js
globalThis.log = [];
const log = (msg) => globalThis.log.push(msg);
if (ready) log("LIVE_tla_binding");
if (state.ready) log("LIVE_tla_property");
if (late() === "set") log("LIVE_tla_function");
run();
log(readEval());
if (evalFlag) log("LIVE_eval_binding");
const done = true;
export { done };

```
