}).a);
function countdown(n) {
	if (n === 1) log("LIVE_recursion");
	if (n > 0) countdown(n - 1);
}
countdown(2);
function setV(o) {
	o.v = "LIVE_holderless";
	return o;
}
log(setV({}).v);
