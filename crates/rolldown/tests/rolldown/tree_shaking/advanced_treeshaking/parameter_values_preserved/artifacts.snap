	if (x) log("LIVE_callback");
}
callback(false);
[true].forEach(callback);
function viaCall(x) {
	if (x) log("LIVE_call");
}
viaCall(false);
viaCall.call(null, true);
function withDefault(x = true) {
	if (x) log("LIVE_default");
}
withDefault(void 0);
function spread(x) {
	if (x) log("LIVE_spread");
}
spread(false);
spread(...[true]);
function leak(o) {
	return arguments[0];
}
log(leak({
	a: "LIVE_arguments",
