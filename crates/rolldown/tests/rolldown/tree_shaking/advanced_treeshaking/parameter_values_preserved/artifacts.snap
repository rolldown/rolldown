// main.js
globalThis.log = [];
const log = (msg) => globalThis.log.push(msg);
function mixed(x) {
	if (x) log("LIVE_mixed");
}
mixed(false);
mixed(true);
function escaped(x) {
	if (x) log("LIVE_escaped");
}
escaped(false);
function viaA(x) {
	if (x) log("LIVE_viaA");
}
function viaB(x) {
	if (x) log("LIVE_viaB");
}
viaA(false);
viaB(false);
(globalThis.pickA ? viaA : viaB)(true);
function reassigned(x) {
	x = true;
	if (x) log("LIVE_reassigned");
}
reassigned(false);
const cfg = { debug: false };
function enable(o) {
	o.debug = true;
}
enable(cfg);
if (cfg.debug) log("LIVE_param_write");
const cfg2 = { debug: false };
function enable2() {
	const alias = cfg2;
	alias.debug = true;
}
enable2();
if (cfg2.debug) log("LIVE_alias_write");
const cfg3 = { debug: false };
function id(o) {
	return o;
}
id(cfg3).debug = true;
if (cfg3.debug) log("LIVE_return_write");
