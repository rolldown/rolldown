## main.js

```js
// helpers.js
function guard(name, run) {
	try {
		run();
	} catch {
		globalThis.log.push(name);
	}
}
// main.js
globalThis.log = [];
const log = (msg) => globalThis.log.push(msg);
const attempt = (name, run) => {
	try {
		run();
	} catch {
		log(name);
	}
};
attempt("LIVE_arrow", () => {
	new WeakSet([1]);
});
attempt("LIVE_function_expression", function() {
	new WeakMap([[1, 1]]);
});
function check() {
	new WeakSet([1]);
}
attempt("LIVE_function_declaration", check);
function Probe(run) {
	try {
		run();
	} catch {
		log("LIVE_function_new");
	}
}
new Probe(() => {
	new WeakSet([1]);
});
var Runner = class {
	constructor(name, run) {
		try {
			run();
		} catch {
			log(name);
		}
	}
};
new Runner("LIVE_class_new", () => {
	new WeakSet([1]);
});
var Derived = class extends Runner {};
new Derived("LIVE_derived_new", () => {
	new WeakSet([1]);
});
({ attempt(run) {
	try {
		run();
	} catch {
		log("LIVE_method");
	}
} }).attempt(() => {
	new WeakSet([1]);
});
const nested = (run) => {
	try {
		[0].forEach(() => run());
	} catch {
		log("LIVE_nested_call");
	}
};
nested(() => {
	new WeakSet([1]);
});
const inArgument = (run) => {
	try {
		String(run());
	} catch {
		log("LIVE_call_in_argument");
	}
};
inArgument(() => {
	new WeakSet([1]);
});
const inner = (run) => {
	try {
		const go = () => run();
		go();
	} catch {
		log("LIVE_inner_function");
	}
};
inner(() => {
	new WeakSet([1]);
});
const destructured = ({ run }) => {
	try {
		run();
	} catch {
		log("LIVE_destructured");
	}
};
destructured({ run: () => {
	new WeakSet([1]);
} });
const rest = (...[run]) => {
	try {
		run();
	} catch {
		log("LIVE_rest");
	}
};
rest(() => {
	new WeakSet([1]);
});
