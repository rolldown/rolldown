function viaArguments() {
	try {
		arguments[0]();
	} catch {
		log("LIVE_arguments");
	}
}
viaArguments(() => {
	new WeakSet([1]);
});
attempt(...["LIVE_spread", () => {
	new WeakSet([1]);
}]);
guard("LIVE_other_module", () => {
	new WeakSet([1]);
});
const swallow = (name, run) => {
	let threw = true;
	try {
		run();
		threw = false;
	} finally {
		if (threw) log(name);
		return;
	}
};
swallow("LIVE_finally_return", () => {
	new WeakSet([1]);
});
for (const name of ["LIVE_finally_continue"]) {
	let threw = true;
	try {
		new WeakMap([[1, 1]]);
		threw = false;
	} finally {
		if (threw) log(name);
		continue;
	}
}
const done = true;
export { done };

