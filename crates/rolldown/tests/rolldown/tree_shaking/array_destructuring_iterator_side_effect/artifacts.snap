// lib.js
const iterable = (name) => ({ [Symbol.iterator]() {
	globalThis.calls.push(name);
	return [][Symbol.iterator]();
} });
/* @__NO_SIDE_EFFECTS__ */
function make(name) {
	return iterable(name);
}
const plain = (name) => iterable(name);
const imported = iterable("imported");

export { make as n, plain as r, imported as t };
