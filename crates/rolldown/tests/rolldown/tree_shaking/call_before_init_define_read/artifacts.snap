# Assets

## main.js

```js
// main.js
try {
	early();
} catch (error) {
	globalThis.calls.push(`define: ${error.name}`);
}
try {
	coalesced();
} catch (error) {
	globalThis.calls.push(`coalesce: ${error.name}`);
}
const early = () => globalThis.calls.push("early");
const coalesced = () => globalThis.calls.push("coalesced");

```
