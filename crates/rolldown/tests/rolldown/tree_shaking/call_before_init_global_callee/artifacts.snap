// a.js
var Skip = class {};
Object.defineProperty(globalThis, "gate", {
	configurable: true,
	get() {
		if (typeof ready !== "undefined") throw new Skip();
		return () => {};
	}
});
try {
	gate(0);
} catch (error) {
	if (!(error instanceof Skip)) throw error;
}
try {
	gate(0);
} catch (error) {
	if (!(error instanceof Skip)) throw error;
}
globalThis.calls.push("a done");
// b.js
const f = () => {};
export { f as t };

