# Assets

## a.js

```js
import { gate } from "./gate.js";
import "./b.js";
// a.js
try {
	gate(0);
} catch (error) {
	if (gateIsReady()) throw error;
}
try {
	gate(0);
} catch (error) {
	if (gateIsReady()) throw error;
}
globalThis.calls.push("a done");
function gateIsReady() {
	try {
		return typeof gate === "function";
	} catch {
		return false;
	}
}

```

