# Assets

## lib.js

```js
// lib.js
let replacedLet = () => {};
var replacedVar = () => {};
function replacedFunction() {
	return 1;
}
function replacedEmpty() {}
const kept = /* @__NO_SIDE_EFFECTS__ */ () => {};
eval(`
  replacedLet = () => globalThis.calls.push('let');
  replacedVar = () => globalThis.calls.push('var');
  replacedFunction = () => globalThis.calls.push('function');
  replacedEmpty = () => globalThis.calls.push('empty function');
`);

export { replacedVar as i, replacedFunction as n, replacedLet as r, replacedEmpty as t };
```

## main.js

```js
import { i as replacedVar, n as replacedFunction, r as replacedLet, t as replacedEmpty } from "./lib.js";

// local.js
function local() {
	return 1;
}
function setup() {
	eval("local = () => globalThis.calls.push('local')");
}
setup();
local();

// main.js
replacedLet();
replacedVar();
replacedFunction();
replacedEmpty();
replacedLet();

```

