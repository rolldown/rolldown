## main.js

```js
// main.js
globalThis.aLoaded = new Promise((resolve) => {
	globalThis.resolveA = resolve;
});
globalThis.dThen = new Promise((resolve) => {
	globalThis.resolveD = resolve;
});
function loadA() {
	import("./a.js");
}
loadA();
const loadB = () => import("./b.js");
function preloadC() {
	import("./c.js");
}
preloadC();
const loadC = () => import("./c.js");
function loadD() {
	import("./d.js");
}
loadD();
export { loadB, loadC };

```
