# warnings

## INEFFECTIVE_DYNAMIC_IMPORT

```text
[INEFFECTIVE_DYNAMIC_IMPORT] target.js is dynamically imported by main.js but also statically imported by main.js, dynamic import will not move module into another chunk.

```

# Assets

## main.js

```js
// HIDDEN [\0rolldown/runtime.js]
// target.js
var target_exports = /* @__PURE__ */ __exportAll({
	then: () => then,
	value: () => value
});
let value = "expected";
function then(resolve) {
	resolve({ value: "assimilated:" + this.value });
}

// main.js
import("./unused.js");
const load = () => Promise.resolve().then(() => target_exports).then((ns) => ns.value);

export { then as keepThen, load };

```

## unused.js

```js
// unused.js
function then(resolve) {
	globalThis.thenCalls = (globalThis.thenCalls ?? 0) + 1;
	globalThis.thenCalled();
	resolve({});
}

export { then };

```
