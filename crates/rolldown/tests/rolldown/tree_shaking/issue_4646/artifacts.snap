## main.js

```js
// main.js
const { a } = await import("./d1.js");
var main_default = await import("./d2.js");
const d3 = await import("./d3.js");
const d4 = () => import("./d4.js");
const d5 = () => import("./d5.js").then((mod) => {
	mod.a;
});

export { a, d3, d4, d5, main_default as default };

```
