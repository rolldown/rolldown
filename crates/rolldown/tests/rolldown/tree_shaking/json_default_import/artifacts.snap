# Assets

## main.js

```js
import assert from "node:assert/strict";

// reexport-mutation.json
var reexport_mutation_default = {
	a: "original",
	b: "unused"
};

// mutator.js
reexport_mutation_default.a = "mutated";

// foo.json
var a$1 = "used";

// bailout.json
var bailout_default = {
	a: "bailout_a",
	b: "bailout_b"
};

// main.js
assert.strictEqual(a$1, "used");
assert.strictEqual(bailout_default.a, "bailout_a");
assert.deepEqual(bailout_default, {
	a: "bailout_a",
	b: "bailout_b"
});
assert.strictEqual(reexport_mutation_default.a, "mutated");

```
