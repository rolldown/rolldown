# Assets

## main.js

```js
import assert from "node:assert";
// foo.js
function c() {
	return "c";
}
// main.js
function hasKey(foo) {
	return "a" in foo;
}
assert.strictEqual(c(), "c");
assert.strictEqual(true, true);
assert.strictEqual(true, true);
assert.strictEqual(false, false);
assert.strictEqual(hasKey({}), false);

```
