var redeclared = /* #__NO_SIDE_EFFECTS__ */ () => {};
var redeclared = () => globalThis.calls.push("redeclared");
//#endregion
//#region rest-default.js
function restDefault(...[value = globalThis.calls.push("rest default")]) {}
//#endregion
//#region iterable.js
/* #__NO_SIDE_EFFECTS__ */
function iterable(name) {
	return { *[Symbol.iterator]() {
		globalThis.calls.push(name);
	} };
}
//#endregion
export { replaced as i, restDefault as n, redeclared as r, iterable as t };

