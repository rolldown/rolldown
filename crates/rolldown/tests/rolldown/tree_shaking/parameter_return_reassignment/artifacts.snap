## main.js

```js
// lib.js
function identity(value) {
	return value;
}
function setIdentity(replacement) {
	identity = replacement;
}

// update.js
setIdentity((value) => {
	globalThis.calls.push("live binding");
	return value;
});

// main.js
identity(2);

