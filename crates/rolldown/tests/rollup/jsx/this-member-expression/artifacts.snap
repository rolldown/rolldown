const h = (type) => type;
// main.js
var Component = class {
	Comp = "Comp";
	nested = { Inner: "Inner" };
	renderInField = () => /* @__PURE__ */ h(this.Comp, null);
	render() {
		return /* @__PURE__ */ h(this.Comp, null);
	}
	renderInArrow() {
		return (() => /* @__PURE__ */ h(this.nested.Inner, null))();
	}
};
const component = new Component();
assert.strictEqual(component.render(), "Comp");
assert.strictEqual(component.renderInArrow(), "Inner");
assert.strictEqual(component.renderInField(), "Comp");
assert.strictEqual({
	ui: {
		Comp: "ObjectComp",
