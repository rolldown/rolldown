{
  "name": "rolldown-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "reference": "typedoc --options typedoc.config.mjs",
    "build": "pnpm reference && doc-kit generate --config-file doc-kit.config.mjs",
    "dev": "pnpm reference && pnpm run \"/^dev:/\"",
    "dev:reference": "typedoc --options typedoc.config.mjs --watch --preserveWatchOutput",
    "dev:site": "node --watch-path=acknowledgements.md --watch-path=apis --watch-path=builtin-plugins --watch-path=contribution-guide --watch-path=development-guide --watch-path=glossary --watch-path=guide --watch-path=in-depth --watch-path=index.mdx --watch-path=team.mdx --watch-path=reference --watch-path=public --watch-path=theme --watch-path=doc-kit.config.mjs node_modules/@doc-kit/cli/bin/cli.mjs generate --config-file doc-kit.config.mjs",
    "dev:serve": "serve dist --listen 5173 --no-port-switching --no-request-logging",
    "preview": "serve dist --listen 5173 --no-port-switching",
    "void": "void"
  },
  "devDependencies": {
    "@doc-kit/cli": "1.0.4",
    "@doc-kit/core": "1.2.1",
    "@doc-kit/generator-react": "0.4.0",
    "@doc-kit/typedoc": "link:../../doc-kit/packages/typedoc",
    "@hpcc-js/wasm-graphviz": "^1.22.0",
    "@node-core/ui-components": "^1.7.6",
    "@voidzero-dev/doc-kit-theme": "github:ovflowd/voidzero-dev-doc-kit-theme#3311715d2fb0fc3327435303f1740d5c6869b3ea",
    "preact": "^10.29.8",
    "serve": "^14.2.6",
    "typedoc": "^0.28.19",
    "void": "^0.20.0",
    "wrangler": "^4.139.0"
  }
}
