{
  "extends": "../../tsconfig.json",
  "include": ["tests/**/*.ts", "vitest.config.mts"],
  "exclude": ["tests/fixtures/**"],
  "compilerOptions": {
    "types": ["node"],
    "rootDir": "./",
    "isolatedDeclarations": false,
    // tests/browser installs @rolldown/browser from a tarball that only exists after
    // `just test-browser`, so type checking reads the same declarations from the workspace build
    "paths": {
      "@rolldown/browser": ["../browser/dist/index.d.mts"]
    }
  }
}
