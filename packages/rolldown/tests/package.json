{
  "name": "rolldown-tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts"
    },
    "./utils": {
      "import": "./src/utils.ts"
    },
    "./types": {
      "types": "./src/types.ts"
    }
  },
  "scripts": {
    "test:main": "RUST_BACKTRACE=1 ROLLDOWN_TEST=1 vitest run --exclude '**/watch.test.ts' --exclude '**/dev-watch.test.ts' --exclude '**/watch/watch-browser.test.ts' --reporter verbose --hideSkippedTests",
    "test:browser": "RUST_BACKTRACE=1 ROLLDOWN_TEST=1 ROLLDOWN_BROWSER_TEST=1 vitest run watch/watch-browser.test.ts --reporter verbose --hideSkippedTests",
    "test:watcher": "RUST_BACKTRACE=1 ROLLDOWN_TEST=1 vitest run watch.test.ts dev-watch.test.ts --exclude '**/watch/watch-browser.test.ts' --reporter verbose --hideSkippedTests",
    "test:wasi-threaded": "RUST_BACKTRACE=1 ROLLDOWN_TEST=1 ROLLDOWN_EXPECT_WASI_THREADS=1 vitest run threaded-wasi.test.ts --reporter verbose --hideSkippedTests",
    "test:cli": "RUST_BACKTRACE=1 ROLLDOWN_TEST=1 vitest run cli-e2e.test.ts --reporter verbose --hideSkippedTests",
    "test:wasi": "ROLLDOWN_WASI_TEST=1 vp run test:main",
    "test:stability": "node ./stability/issue-3453/src/build.mjs && node ./stability/issue-3453/verify.mjs",
    "test:wasi-runtime-lifecycle": "node ./wasi-runtime-lifecycle.mjs",
    "test:wasi-threaded-stress": "node ./wasi/threaded-memory-stress.mjs",
    "test:wasi-threaded-stress:bounds-checks": "node ./wasi/threaded-memory-stress.mjs --cases bundle-mt4 --runs 20 --node-flag=--wasm-enforce-bounds-checks",
    "test:wasi-threaded-stress:no-trap-handler": "node ./wasi/threaded-memory-stress.mjs --cases bundle-mt4 --runs 10 --node-flag=--disable-wasm-trap-handler",
    "test:wasi-threaded-stress:forced-growth": "node ./wasi/threaded-memory-stress.mjs --cases build-mt4 --runs 20 --initial-pages min --expect-grows some --node-flag=--wasm-enforce-bounds-checks",
    "test:wasi-threaded-stress:handoff": "node ./wasi/threaded-memory-stress.mjs --cases bundle-mt4 --runs 20 --initial-pages min --expect-grows some --node-flag=--wasm-enforce-bounds-checks",
    "test:wasi-threaded-stress:heap-ceiling": "node ./wasi/threaded-memory-stress.mjs --cases bundle-mt4 --hold-mib 1536",
    "test:wasi-threaded-stress:no-growth": "node ./wasi/threaded-memory-stress.mjs --cases build-mt4,bundle-mt --expect-grows zero",
    "test:wasi-worker-crash": "node ./wasi/worker-crash-latch.mjs",
    "test:wasi-pool-preload": "node ./wasi/pool-worker-preload.mjs",
    "test:types": "vitest run --typecheck.only --reporter verbose --hideSkippedTests"
  },
  "dependencies": {
    "rolldown": "workspace:*",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "catalog:",
    "@rolldown/test-dev-server": "workspace:*",
    "@rolldown/test-dual-format": "link:./package-fixtures/test-dual-format",
    "@rolldown/test-side-effects-field": "link:./package-fixtures/test-side-effects-field",
    "@rolldown/test-side-effects-field-glob": "file:./package-fixtures/test-side-effects-field-glob",
    "@types/node": "catalog:",
    "source-map-js": "^1.2.1",
    "tsx": "catalog:"
  }
}
